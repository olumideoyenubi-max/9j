<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console "test run": drives the real NaijaHustle.Core rules through a scripted playthrough. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="Program.cs" />
    <None Include="../../Assets/_Project/Resources/Content/*.json" Link="Content/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
